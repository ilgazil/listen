# Accès de déploiement vers Infomaniak — copiez-moi en .deploy.env puis renseignez.
# NE COMMITTEZ JAMAIS .deploy.env (gitignoré à la racine).
PROD_HOST=ssh.infomaniak.ch
PROD_SSH_USER=user123
PROD_PORT=22
# Chemin du vhost côté serveur (relatif au home SSH, ou chemin absolu).
PROD_PATH=www/exemple.com
# URL publique du site (optionnelle) — affichée dans le récapitulatif du déploiement.
PROD_URL=https://exemple.com
# Binaire PHP CLI disponible sur le serveur (php8.3 / php...). Doit avoir l'extension intl.
PROD_PHP=php8.3
# Clé SSH privée dédiée au déploiement (générée par `make ssh-key`, envoyée par `make ssh-copy`).
# Laissez vide pour utiliser la clé par défaut de ~/.ssh. Un mot de passe demandé = échec immédiat.
DEPLOY_SSH_KEY=~/.ssh/id_ed25519_infomaniak
# 1 = composer install --no-dev exécuté sur le serveur (vendor non envoyé, à réinstaller à chaque déploiement).
# 0 = le vendor local est envoyé tel quel (pratique si composer n'est pas dispo côté serveur).
PROD_USE_COMPOSER=0