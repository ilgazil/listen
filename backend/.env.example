# Copiez ce fichier en .env.local (ou complétez .env.dev) et renseignez vos valeurs.
# Ne committez JAMAIS de vraies valeurs/secrets. Aucun des fichiers .env*.local n'est versionné.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=changez-moi
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Dev : PostgreSQL (docker compose). Prod : MariaDB (Infomaniak), avec serverVersion réel (ex. 10.6.19-MariaDB)
DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/app?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> listen (app) ###
# Upload/stockage 1Fichier : https://1fichier.com/api/
API_1FICHIER_TOKEN=remplacez-par-votre-token
API_1FICHIER_APP_FOLDER_ID=id-du-dossier-1fichier

# Notification Discord — webhook « nouveau livre » (optionnel)
DISCORD_NEW_BOOK_WEBHOOK=https://discord.com/api/webhooks/xxxx

# Notification Discord — webhook « erreurs runtime PHP » (optionnel)
DISCORD_SENTRY_WEBHOOK=https://discord.com/api/webhooks/xxxx

# URL publique de l'app (optionnel) — lien des notifications Discord.
# Par défaut dérivée de la requête courante ; définir APP_BASE_URL pour surcharger
# (recommandé en prod derrière un reverse proxy qui force http, et obligatoire
# hors contexte requête, ex. commandes CLI des notifications).
# APP_BASE_URL=https://exemple.com
###< listen (app) ###